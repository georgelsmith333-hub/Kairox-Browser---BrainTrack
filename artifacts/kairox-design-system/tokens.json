{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Kairox Browser design tokens. A dark graphite base, warm light mode, one strong cyan signal, soft depth, and compact information hierarchy for browsing, profiles, privacy, network, and developer workflows.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F5F1EA" },
      "foreground": { "$value": "#11161D" },
      "border": { "$value": "#D9D7D1" },
      "card": { "$value": "#FFFDF8" },
      "cardForeground": { "$value": "#11161D" },
      "popover": { "$value": "#FFFDF8" },
      "popoverForeground": { "$value": "#11161D" },
      "primary": {
        "$value": "#0C6A83",
        "$description": "Kairox cyan signal for primary actions, links, active states, and trusted route indicators."
      },
      "primaryForeground": { "$value": "#F7FCFD" },
      "secondary": { "$value": "#E8E7E1" },
      "secondaryForeground": { "$value": "#1B252D" },
      "muted": { "$value": "#EDEBE5" },
      "mutedForeground": { "$value": "#5F666B" },
      "accent": { "$value": "#D8EEF0" },
      "accentForeground": { "$value": "#12343E" },
      "destructive": { "$value": "#B83D4C" },
      "destructiveForeground": { "$value": "#FFF8F6" },
      "input": { "$value": "#D4D4CE" },
      "ring": { "$value": "#0C6A83" },
      "chart1": { "$value": "#0C6A83" },
      "chart2": { "$value": "#B77B2B" },
      "chart3": { "$value": "#6A5AA8" },
      "chart4": { "$value": "#2C8C72" },
      "chart5": { "$value": "#B83D4C" },
      "sidebar": { "$value": "#EAE7DF" },
      "sidebarForeground": { "$value": "#263139" },
      "sidebarBorder": { "$value": "#D3D2CC" },
      "sidebarPrimary": { "$value": "#0C6A83" },
      "sidebarPrimaryForeground": { "$value": "#F7FCFD" },
      "sidebarAccent": { "$value": "#D8EEF0" },
      "sidebarAccentForeground": { "$value": "#12343E" },
      "sidebarRing": { "$value": "#0C6A83" }
    },
    "dark": {
      "background": { "$value": "#0B0E13" },
      "foreground": { "$value": "#F4F1EA" },
      "border": { "$value": "#27303A" },
      "card": { "$value": "#121821" },
      "cardForeground": { "$value": "#F4F1EA" },
      "popover": { "$value": "#151C25" },
      "popoverForeground": { "$value": "#F4F1EA" },
      "primary": {
        "$value": "#6EE1F0",
        "$description": "Kairox cyan signal for primary actions, links, active states, and trusted route indicators."
      },
      "primaryForeground": { "$value": "#081116" },
      "secondary": { "$value": "#1B2530" },
      "secondaryForeground": { "$value": "#EAF0F2" },
      "muted": { "$value": "#151D27" },
      "mutedForeground": { "$value": "#9BA9B0" },
      "accent": { "$value": "#17333D" },
      "accentForeground": { "$value": "#B6F1F5" },
      "destructive": { "$value": "#E65B68" },
      "destructiveForeground": { "$value": "#220A0E" },
      "input": { "$value": "#27303A" },
      "ring": { "$value": "#6EE1F0" },
      "chart1": { "$value": "#6EE1F0" },
      "chart2": { "$value": "#F3BD62" },
      "chart3": { "$value": "#B7A5F0" },
      "chart4": { "$value": "#63D0AE" },
      "chart5": { "$value": "#F47C87" },
      "sidebar": { "$value": "#0F141B" },
      "sidebarForeground": { "$value": "#DDE7EA" },
      "sidebarBorder": { "$value": "#27303A" },
      "sidebarPrimary": { "$value": "#6EE1F0" },
      "sidebarPrimaryForeground": { "$value": "#081116" },
      "sidebarAccent": { "$value": "#17333D" },
      "sidebarAccentForeground": { "$value": "#B6F1F5" },
      "sidebarRing": { "$value": "#6EE1F0" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Compact, legible UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Soft, controlled depth for cards, controls, and panels without playful bubbles."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-point spacing rhythm for a compact but breathable browser interface."
    }
  }
}